# Domain-relay deployment test release. v1.0.0 does not implement this profile.
C2_IMAGE=ghcr.io/firekula/dflegacy-chapter-two:v1.0.1
# DDNS name only, without scheme or port; also accepts IPv4/IPv6 literals.
C2_SERVER_HOST=game.example.com
# Dual stack by default; use 0.0.0.0 for an IPv4-only host.
C2_BIND_HOST=::
C2_DATA_DIR=/home/firekula/compose/DFLegacy-ChapterTwo/data
C2_PVF_PATH=/home/firekula/compose/DFLegacy-ChapterTwo/Script.chapter-two.server.pvf
C2_MANAGER_HOST_PORT=58092
C2_TEST_CERA_TOP_UP=false
C2_REGIONAL_CHANNELS=true
C2_WEEKEND_DOUBLE=true
