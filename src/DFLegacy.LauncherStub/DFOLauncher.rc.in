1 ICON "@DFL_ICON@"

LANGUAGE 9, 1
1 VERSIONINFO
 FILEVERSION @DFL_VERSION_COMPONENTS@,0
 PRODUCTVERSION @DFL_VERSION_COMPONENTS@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "FireKula"
            VALUE "FileDescription", "@DFL_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@DFL_LAUNCHER_VERSION@.0"
            VALUE "InternalName", "@DFL_INTERNAL_NAME@"
            VALUE "LegalCopyright", "Copyright (C) 2026 FireKula"
            VALUE "OriginalFilename", "@DFL_EXECUTABLE_NAME@"
            VALUE "ProductName", "DFLegacy"
            VALUE "ProductVersion", "@DFL_PRODUCT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
