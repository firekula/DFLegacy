<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- No culture use: keeps the library (and its hosts) runnable on hosts
         without ICU, matching the server's minimal-container story. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>DFLegacy.Relay</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DFLegacy.Relay.Tests" />
  </ItemGroup>
</Project>
