    <TargetName>ijl15_tests</TargetName>
    <!-- The test loads ijl15.dll by bare name, so it resolves the module built
         next to it rather than any ijl15 the host happens to have. -->
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
