      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <PostBuildEvent>
      <!-- The tests load ijl15.dll by bare name, so the module under test has to
           sit beside the test executable instead of in the host's search path. -->
      <Command>powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $src=Join-Path '$(MSBuildThisFileDirectory)..\..\..\artifacts\native\ijl15\$(Configuration)' 'ijl15.dll'; $dst=Join-Path '$(OutDir)' 'ijl15.dll'; Copy-Item -LiteralPath $src -Destination $dst -Force; $cfgSrc=Join-Path '$(MSBuildThisFileDirectory)..' 'Config.ini'; $cfgDst=Join-Path '$(OutDir)' 'Config.ini'; Copy-Item -LiteralPath $cfgSrc -Destination $cfgDst -Force; Write-Host ('copied ' + $src + ' and ' + $cfgSrc + ' -> ' + '$(OutDir)')"</Command>
      <Message>Copying the ijl15 module under test next to the test executable</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
