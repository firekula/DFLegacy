<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DFLegacy.Manager/DFLegacy.Manager.csproj" />
    <Content Include="../../tools/release/release.py;../../tools/release/bundle.py;../../tools/release/github_publish.py;../../tools/release/update_v4.py"
             Link="tools/release/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
