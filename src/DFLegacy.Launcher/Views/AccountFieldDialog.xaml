<Window x:Class="DFLegacy.Launcher.Views.AccountFieldDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DFLegacy.Launcher.Controls"
        Title="编辑账号" Width="390" SizeToContent="Height" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <c:ClassicDialogFrame Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}">
    <StackPanel>
      <c:PixelText Text="显示名" Style="{DynamicResource ClassicLabel}"/>
      <TextBox x:Name="DisplayNameBox" Margin="0,0,0,10" AutomationProperties.Name="显示名"/>
      <c:PixelText Text="账号" Style="{DynamicResource ClassicLabel}"/>
      <TextBox x:Name="AccountBox" Margin="0,0,0,10" AutomationProperties.Name="账号"/>
      <c:PixelText Text="密码" Style="{DynamicResource ClassicLabel}"/>
      <PasswordBox x:Name="PasswordBox" Margin="0,0,0,12" AutomationProperties.Name="密码"/>
      <Grid Margin="0,4,0,0">
        <CheckBox x:Name="RememberBox" Content="记住密码" IsChecked="True" Width="110" Margin="0"
                  VerticalAlignment="Center" HorizontalAlignment="Left"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <c:SkinButton Content="取消" Width="80" Margin="0,0,8,0" Style="{DynamicResource ClassicButton}" Click="Cancel_Click"/>
          <c:SkinButton Content="确定" Width="80" IsDefault="True" Style="{DynamicResource ClassicButton}" Click="Ok_Click"/>
        </StackPanel>
      </Grid>
    </StackPanel>
  </c:ClassicDialogFrame>
</Window>
