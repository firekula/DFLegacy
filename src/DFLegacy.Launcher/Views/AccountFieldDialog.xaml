<Window x:Class="DFLegacy.Launcher.Views.AccountFieldDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑账号" Height="300" Width="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="显示名"/>
    <TextBox Grid.Row="1" x:Name="DisplayNameBox" Margin="0,4,0,8"/>
    <TextBlock Grid.Row="2" Text="账号"/>
    <TextBox Grid.Row="3" x:Name="AccountBox" Margin="0,4,0,8"/>
    <TextBlock Grid.Row="4" Text="密码"/>
    <PasswordBox Grid.Row="5" x:Name="PasswordBox" Margin="0,4,0,8"/>
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <CheckBox x:Name="RememberBox" Content="记住密码" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center"/>
      <Button Content="取消" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
      <Button Content="确定" Width="80" Click="Ok_Click"/>
    </StackPanel>
  </Grid>
</Window>
