<Window x:Class="DFLegacy.Launcher.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="注册账号" Width="380" SizeToContent="Height"
        Background="White" Foreground="#222222"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="用户名（4-32）"/>
    <TextBox    Grid.Row="1" x:Name="UserNameBox" Margin="0,4,0,8"/>
    <TextBlock Grid.Row="2" Text="密码（6-128）"/>
    <PasswordBox Grid.Row="3" x:Name="PasswordBox" Margin="0,4,0,8"/>
    <TextBlock Grid.Row="4" Text="确认密码"/>
    <PasswordBox Grid.Row="5" x:Name="ConfirmBox" Margin="0,4,0,8"/>
    <TextBlock Grid.Row="6" Text="QQ（找回密码用）"/>
    <TextBox Grid.Row="7" x:Name="OicqBox" MinHeight="28" Margin="0,4,0,8"/>
    <CheckBox Grid.Row="8" x:Name="TestAccountBox" Content="测试账号"
              Foreground="#222222" MinHeight="24" VerticalAlignment="Center"/>
    <Button Grid.Row="9" x:Name="SubmitBtn" Content="注册" Height="36"
            HorizontalAlignment="Stretch" Margin="0,12,0,0" Click="SubmitBtn_Click"/>
  </Grid>
</Window>
