<Window x:Class="DFLegacy.Launcher.Views.AccountEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DFLegacy.Launcher.Controls"
        Title="账号管理" Height="418" Width="550" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <c:ClassicDialogFrame Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                CanUserResizeRows="False" CanUserAddRows="False" CanUserReorderColumns="False"
                HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
                HorizontalGridLinesBrush="#423B2A" Background="#161711" Foreground="#F4E9CA"
                BorderBrush="#987D4F" BorderThickness="1" RowHeight="29" ColumnHeaderHeight="29"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Grid_MouseDoubleClick"
                AutomationProperties.Name="已保存账号">
        <DataGrid.Resources>
          <Style x:Key="AccountCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          </Style>
        </DataGrid.Resources>
        <DataGrid.ColumnHeaderStyle>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#FFD883"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                  <Border x:Name="HeaderFrame" Background="#332C1F" BorderBrush="#987D4F" BorderThickness="0,0,1,1" Padding="8,0">
                    <DockPanel>
                      <Path x:Name="SortArrow" DockPanel.Dock="Right" Width="8" Height="5" Fill="#FFD883"
                            VerticalAlignment="Center" Visibility="Collapsed"/>
                      <ContentPresenter VerticalAlignment="Center"/>
                    </DockPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderFrame" Property="Background" Value="#51432A"/></Trigger>
                    <Trigger Property="SortDirection" Value="Ascending">
                      <Setter TargetName="SortArrow" Property="Data" Value="M 0,5 L 4,0 L 8,5 Z"/>
                      <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="SortDirection" Value="Descending">
                      <Setter TargetName="SortArrow" Property="Data" Value="M 0,0 L 4,5 L 8,0 Z"/>
                      <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </DataGrid.ColumnHeaderStyle>
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#1B1C15"/>
            <Setter Property="Foreground" Value="#F4E9CA"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2A281C"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#51432A"/><Setter Property="Foreground" Value="#FFD883"/></Trigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.CellStyle>
          <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                  <Border x:Name="FocusFrame" BorderBrush="Transparent" BorderThickness="1" Background="Transparent" Padding="7,0">
                    <ContentPresenter VerticalAlignment="Center" ClipToBounds="True"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusFrame" Property="BorderBrush" Value="#C5A66D"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </DataGrid.CellStyle>
        <DataGrid.Columns>
          <DataGridTextColumn Header="显示名" Width="132" Binding="{Binding DisplayName}" ElementStyle="{StaticResource AccountCellText}"/>
          <DataGridTextColumn Header="账号" Width="150" Binding="{Binding Account}" ElementStyle="{StaticResource AccountCellText}"/>
          <DataGridTemplateColumn Header="记住密码" Width="76" SortMemberPath="RememberPassword">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock>
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="否"/>
                      <Style.Triggers><DataTrigger Binding="{Binding RememberPassword}" Value="True"><Setter Property="Text" Value="是"/></DataTrigger></Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="创建时间" Width="124" Binding="{Binding CreateTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>
        </DataGrid.Columns>
      </DataGrid>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <c:SkinButton Content="新增" Style="{DynamicResource ClassicButton}" Margin="0,0,8,0" Click="Add_Click"/>
        <c:SkinButton Content="编辑" Style="{DynamicResource ClassicButton}" Margin="0,0,8,0" Click="Edit_Click"/>
        <c:SkinButton Content="删除" Style="{DynamicResource ClassicButton}" Margin="0,0,8,0" Click="Delete_Click"/>
        <c:SkinButton Content="设为默认" Style="{DynamicResource ClassicButton}" Margin="0,0,8,0" Click="SetDefault_Click"/>
        <c:SkinButton Content="关闭" Style="{DynamicResource ClassicButton}" Click="Close_Click"/>
      </StackPanel>
    </Grid>
  </c:ClassicDialogFrame>
</Window>
