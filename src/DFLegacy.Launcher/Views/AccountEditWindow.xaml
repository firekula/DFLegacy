<Window x:Class="DFLegacy.Launcher.Views.AccountEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="账号管理" Height="420" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DataGrid Grid.Row="0" x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
              HeadersVisibility="Column" MouseDoubleClick="Grid_MouseDoubleClick">
      <DataGrid.Columns>
        <DataGridTextColumn Header="显示名" Binding="{Binding DisplayName}"/>
        <DataGridTextColumn Header="账号"   Binding="{Binding Account}"/>
        <DataGridTextColumn Header="记住密码" Binding="{Binding RememberPassword}"/>
        <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime}"/>
      </DataGrid.Columns>
    </DataGrid>
    <UniformGrid Grid.Row="1" Columns="4" Margin="0,8,0,0">
      <Button Content="新增" Margin="2" Click="Add_Click"/>
      <Button Content="编辑" Margin="2" Click="Edit_Click"/>
      <Button Content="删除" Margin="2" Click="Delete_Click"/>
      <Button Content="设为默认" Margin="2" Click="SetDefault_Click"/>
    </UniformGrid>
    <Button Grid.Row="2" Content="关闭" Height="32" Margin="0,12,0,0" Click="Close_Click"/>
  </Grid>
</Window>
