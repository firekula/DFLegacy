<Window x:Class="DFLegacy.Launcher.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="650" MinHeight="380" Width="520" MinWidth="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TabControl>
      <TabItem Header="连接">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="入口 Host"/><TextBox x:Name="HostBox" Margin="0,4,0,8"/>
              <TextBlock Text="入口端口"/><TextBox x:Name="PortBox" Margin="0,4,0,8"/>
              <TextBlock Text="账号服务端口（与入口同域名）"/>
              <TextBox x:Name="AccountPortBox" Width="120" HorizontalAlignment="Left" Margin="0,4,0,0"/>
              <TextBlock x:Name="AccountUrlHint" Margin="0,4,0,8" TextWrapping="Wrap"/>
              <TextBlock Text="高级：覆盖账号 API 地址（留空使用域名与端口）" TextWrapping="Wrap"/>
              <TextBox x:Name="AccountUrlBox" Margin="0,4,0,8"/>
              <TextBlock Text="客户端路径"/>
              <Grid Margin="0,4,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ClientPathBox"/>
                <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="Browse_Click"/>
              </Grid>
              <WrapPanel Margin="0,0,0,8">
                <CheckBox x:Name="StartServerBox" Content="本地自动启动服务端" Margin="0,0,16,4"/>
                <CheckBox x:Name="RelayEnabledBox" Content="启用 IPv6 中继" Margin="0,0,0,4"/>
              </WrapPanel>
              <TextBlock Text="主题"/>
              <ComboBox x:Name="ThemeBox" SelectedValuePath="Content" Margin="0,4,0,8">
                <ComboBoxItem Content="auto"/><ComboBoxItem Content="light"/><ComboBoxItem Content="dark"/>
              </ComboBox>
              <TextBlock Text="中继 TCP 端口"/><TextBox x:Name="TcpPortsBox" Margin="0,4,0,8"/>
              <TextBlock Text="中继地址优先级"/>
              <ComboBox x:Name="PreferenceBox" SelectedValuePath="Content" Margin="0,4,0,8">
                <ComboBoxItem Content="ipv6"/><ComboBoxItem Content="ipv4"/>
              </ComboBox>
            </StackPanel>
          </ScrollViewer>
          <Button Grid.Row="1" Content="保存连接设置" HorizontalAlignment="Right" Padding="16,6" Margin="0,12,0,0" Click="Save_Click"/>
        </Grid>
      </TabItem>
      <TabItem Header="游戏显示">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="实际客户端" FontWeight="SemiBold"/>
              <TextBlock x:Name="DisplayTargetText" TextWrapping="Wrap" Margin="0,4,0,12"/>
              <TextBlock x:Name="DisplayErrorText" TextWrapping="Wrap" Margin="0,0,0,12"/>
              <StackPanel x:Name="DisplayEditorPanel">
                <TextBlock Text="窗口分辨率（4:3）"/>
                <ComboBox x:Name="ResolutionBox" Margin="0,4,0,12" SelectionChanged="DisplaySelectionChanged"/>
                <TextBlock Text="画质"/>
                <ComboBox x:Name="PresentationBox" SelectedValuePath="Tag" Margin="0,4,0,8" SelectionChanged="DisplaySelectionChanged">
                  <ComboBoxItem Content="清晰平滑（推荐）" Tag="sharp"/>
                  <ComboBoxItem Content="清晰" Tag="point"/>
                  <ComboBoxItem Content="平滑" Tag="linear"/>
                  <ComboBoxItem Content="旧版兼容" Tag="legacy"/>
                </ComboBox>
                <TextBlock x:Name="DisplayDescriptionText" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock Text="尺寸指游戏画面区域。更大的窗口不会增加游戏视野。" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="保存后，下次启动游戏生效。当前运行的游戏不会重启。" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock x:Name="DisplayRuntimeText" TextWrapping="Wrap" Margin="0,0,0,12"/>
              </StackPanel>
              <TextBlock x:Name="DisplayWarningText" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <TextBlock x:Name="DisplaySaveResultText" TextWrapping="Wrap" Margin="0,0,0,8"/>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="DisplayReloadButton" Content="重新读取" Padding="12,6" Margin="0,0,8,0" Click="DisplayReload_Click"/>
            <Button x:Name="DisplaySaveButton" Content="保存显示设置" Padding="12,6" Click="DisplaySave_Click"/>
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
    <Button Grid.Row="1" Content="关闭" Width="80" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Cancel_Click"/>
  </Grid>
</Window>
