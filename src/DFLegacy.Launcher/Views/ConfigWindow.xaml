<Window x:Class="DFLegacy.Launcher.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="设置" Height="500" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="入口 Host"/><TextBox Grid.Row="1" x:Name="HostBox" Margin="0,4,0,8"/>
    <TextBlock Grid.Row="2" Text="入口端口"/><TextBox Grid.Row="3" x:Name="PortBox" Margin="0,4,0,8"/>
    <TextBlock Grid.Row="4" Text="账号 API URL"/><TextBox Grid.Row="5" x:Name="AccountUrlBox" Margin="0,4,0,8"/>
    <TextBlock Grid.Row="6" Text="客户端路径"/><StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,4,0,8">
        <TextBox x:Name="ClientPathBox" Width="280"/><Button Content="浏览…" Margin="8,0,0,0" Click="Browse_Click"/>
    </StackPanel>
    <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,0,0,8">
        <CheckBox x:Name="StartServerBox" Content="本地自动启动服务端" VerticalAlignment="Center"/>
        <CheckBox x:Name="RelayEnabledBox" Content="启用 IPv6 中继" Margin="16,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="主题" VerticalAlignment="Center"/>
        <!-- SelectedValuePath="Content"：非可编辑 ComboBox 且条目是 ComboBoxItem 包装时
             .Text 不可靠（可能为空），代码里读写 SelectedValue（string）。 -->
        <ComboBox x:Name="ThemeBox" Margin="12,0,0,0" Width="100" SelectedValuePath="Content">
            <ComboBoxItem Content="auto"/><ComboBoxItem Content="light"/><ComboBoxItem Content="dark"/>
        </ComboBox>
    </StackPanel>
    <StackPanel Grid.Row="10" Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="中继 TCP 端口" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="TcpPortsBox" Width="120" Margin="0,0,16,0"/>
        <TextBlock Text="Preference" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="PreferenceBox" Width="80" SelectedValuePath="Content"><ComboBoxItem Content="ipv6"/><ComboBoxItem Content="ipv4"/></ComboBox>
    </StackPanel>
    <StackPanel Grid.Row="13" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
        <Button Content="保存" Width="80" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
