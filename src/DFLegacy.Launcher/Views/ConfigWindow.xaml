<Window x:Class="DFLegacy.Launcher.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DFLegacy.Launcher.Controls"
        Title="游戏设置" Width="480" Height="459" MinWidth="480" MinHeight="360" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#F4E9CA" FontFamily="宋体" FontSize="13" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True" MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ClassicStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid x:Name="SettingsSurface" Width="480" Margin="0,8,0,0">
    <Image Margin="0,23,0,0" Source="../Assets/Skin/classic-settings-panel.png" Stretch="Fill"/>
    <Image x:Name="SettingsCrest" Width="233" Height="48" HorizontalAlignment="Center" VerticalAlignment="Top" Source="../Assets/Skin/classic-crest.png"><Image.RenderTransform><TranslateTransform Y="-8"/></Image.RenderTransform></Image>
    <c:PixelText Text="游戏设置" FontSize="20" Foreground="{StaticResource ClassicGold}" TextAlignment="Center" TextWrapping="NoWrap" Height="30" VerticalAlignment="Top" Margin="34,51,34,0"/>
    <c:SkinButton Width="25" Height="23" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,15,0" Style="{StaticResource ClassicImageButton}" NormalSource="../Assets/Skin/buton_close00.png" HoverSource="../Assets/Skin/buton_close01.png" PressedSource="../Assets/Skin/buton_close02.png" AutomationProperties.Name="关闭设置" IsCancel="True" Click="Cancel_Click"/>
    <TabControl x:Name="SettingsTabs" Style="{StaticResource ClassicTabs}" Margin="34,96,34,23" SelectedIndex="2">
      <TabItem Header="连接设置">
        <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer x:Name="ConnectionScroll" Style="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
              <c:PixelText Text="游戏客户端" Style="{StaticResource ClassicLabel}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ClientPathBox" AutomationProperties.Name="客户端路径"/><c:SkinButton Grid.Column="1" Content="浏览…" Style="{StaticResource ClassicButton}" Margin="8,0,0,0" Click="Browse_Click"/></Grid>
              <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
                <StackPanel><c:PixelText Text="服务器地址" Style="{StaticResource ClassicLabel}"/><TextBox x:Name="HostBox" AutomationProperties.Name="服务器地址"/></StackPanel>
                <StackPanel Grid.Column="2"><c:PixelText Text="入口端口" Style="{StaticResource ClassicLabel}"/><TextBox x:Name="PortBox" AutomationProperties.Name="入口端口"/></StackPanel>
              </Grid>
              <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><c:PixelText Text="账号服务端口" Style="{StaticResource ClassicLabel}"/><TextBox x:Name="AccountPortBox" AutomationProperties.Name="账号服务端口"/></StackPanel>
                <c:PixelText Grid.Column="2" x:Name="AccountUrlHint" Foreground="{StaticResource ClassicSecondary}" FontSize="12" VerticalAlignment="Bottom"/>
              </Grid>
              <Expander Header="高级连接选项" Margin="0,16,0,0">
                <StackPanel>
                  <c:PixelText Text="覆盖账号服务地址（留空使用域名与端口）" Style="{StaticResource ClassicLabel}"/><TextBox x:Name="AccountUrlBox" AutomationProperties.Name="覆盖账号服务地址"/>
                  <CheckBox x:Name="StartServerBox" Content="本地自动启动服务端" Margin="0,16,0,8"/><CheckBox x:Name="RelayEnabledBox" Content="启用 IPv6 中继"/>
                  <c:PixelText Text="中继 TCP 端口" Style="{StaticResource ClassicLabel}" Margin="0,8,0,7"/><TextBox x:Name="TcpPortsBox" AutomationProperties.Name="中继 TCP 端口"/>
                  <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><c:PixelText Text="中继地址优先级" Style="{StaticResource ClassicLabel}"/><ComboBox x:Name="PreferenceBox" SelectedValuePath="Tag" AutomationProperties.Name="中继地址优先级"><ComboBoxItem Content="优先 IPv6" Tag="ipv6"/><ComboBoxItem Content="优先 IPv4" Tag="ipv4"/></ComboBox></StackPanel>
                    <StackPanel Grid.Column="2"><c:PixelText Text="其他窗口主题" Style="{StaticResource ClassicLabel}"/><ComboBox x:Name="ThemeBox" SelectedValuePath="Tag" AutomationProperties.Name="其他窗口主题"><ComboBoxItem Content="跟随系统" Tag="auto"/><ComboBoxItem Content="浅色" Tag="light"/><ComboBoxItem Content="深色" Tag="dark"/></ComboBox></StackPanel>
                  </Grid>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
          <Grid Grid.Row="1" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><c:PixelText Text="连接与显示分别保存" FontSize="12" Foreground="{StaticResource ClassicSecondary}"/><c:SkinButton Grid.Column="1" Content="保存连接设置" Style="{StaticResource ClassicButton}" Click="Save_Click"/></Grid>
        </Grid>
      </TabItem>
      <TabItem Header="诊断">
        <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer Style="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"><StackPanel>
          <CheckBox x:Name="DiagnosticEnabledBox" Content="自动发送基本错误诊断" Margin="0,4,0,12"/>
          <CheckBox x:Name="DiagnosticSmallDumpsBox" Content="在本机保留小型崩溃转储（下次启动生效）" Margin="0,0,0,12"/>
          <c:PixelText Text="诊断仅包含错误类型、模块相对位置和基本系统信息，用于排查启动失败、崩溃与异常断线。" Margin="0,0,0,12"/>
          <c:PixelText Text="账号、密码、聊天、截图与原始内存不会上传。原始转储仅保存在当前用户本地。" Foreground="{StaticResource ClassicSecondary}" Margin="0,0,0,12"/>
          <c:PixelText x:Name="DiagnosticStatusText" Margin="0,0,0,16"/>
          <c:PixelText Text="此设置只影响当前 Windows 用户；关闭后，旧记录不会在重新开启时自动补传。" Foreground="{StaticResource ClassicSecondary}" Margin="0,0,0,16"/>
          </StackPanel></ScrollViewer>
          <c:SkinButton Grid.Row="1" x:Name="DiagnosticSaveButton" Content="保存诊断设置" Style="{StaticResource ClassicButton}" HorizontalAlignment="Right" Margin="0,12,0,0" Click="DiagnosticSave_Click"/>
        </Grid>
      </TabItem>
      <TabItem Header="游戏显示">
        <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer x:Name="DisplayScroll" Style="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
              <c:PixelText x:Name="DisplaySaveResultText" Style="{StaticResource ClassicNotice}"/>
              <c:PixelText x:Name="DisplayErrorText" Style="{StaticResource ClassicNotice}" Foreground="#FFB7A7"/>
              <c:PixelText x:Name="DisplayWarningText" Style="{StaticResource ClassicNotice}"/>
              <StackPanel x:Name="DisplayEditorPanel">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="21"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><c:PixelText Text="窗口分辨率" Style="{StaticResource ClassicLabel}"/><ComboBox x:Name="ResolutionBox" AutomationProperties.Name="窗口分辨率" SelectionChanged="DisplaySelectionChanged"/></StackPanel>
                  <StackPanel Grid.Column="2"><c:PixelText Text="画质模式" Style="{StaticResource ClassicLabel}"/><ComboBox x:Name="PresentationBox" SelectedValuePath="Tag" AutomationProperties.Name="画质模式" SelectionChanged="DisplaySelectionChanged"><ComboBoxItem Content="清晰平滑 · 推荐" Tag="sharp"/><ComboBoxItem Content="像素清晰" Tag="point"/><ComboBoxItem Content="柔和平滑" Tag="linear"/><ComboBoxItem Content="旧版兼容" Tag="legacy"/></ComboBox></StackPanel>
                </Grid>
                <c:PixelText x:Name="DisplayDescriptionText" Margin="0,24,0,0"/>
                <c:PixelText Text="保持原始 4:3 画面。窗口变大，游戏视野不变。" Foreground="{StaticResource ClassicSecondary}" Margin="0,16,0,0"/>
                <Border Height="1" Background="#625638" Margin="0,20,0,15"/>
                <Expander Header="客户端与最近运行信息">
                  <StackPanel><c:PixelText Text="当前配置的客户端" Style="{StaticResource ClassicLabel}"/><c:PixelText x:Name="DisplayTargetText" Foreground="{StaticResource ClassicSecondary}"/>
                    <c:PixelText Text="最近一次实际运行" Style="{StaticResource ClassicLabel}" Margin="0,15,0,7"/><c:PixelText x:Name="DisplayRuntimeText" Foreground="{StaticResource ClassicSecondary}"/>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="88"/><ColumnDefinition Width="10"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
              <c:PixelText x:Name="DisplayFooterText" Text="下次启动后生效" FontSize="11" Foreground="{StaticResource ClassicSecondary}"/>
              <c:SkinButton x:Name="DisplayReloadButton" Grid.Column="1" Content="重新读取" FontSize="12" Style="{StaticResource ClassicButton}" Click="DisplayReload_Click"/>
              <c:SkinButton x:Name="DisplaySaveButton" Grid.Column="3" Content="保存设置" FontSize="12" Style="{StaticResource ClassicButton}" Click="DisplaySave_Click"/>
            </Grid>
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
