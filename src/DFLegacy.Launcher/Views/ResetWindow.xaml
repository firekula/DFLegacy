<Window x:Class="DFLegacy.Launcher.Views.ResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DFLegacy.Launcher.Controls"
        Title="找回密码" Width="390" SizeToContent="Height" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <c:ClassicDialogFrame Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <c:PixelText Grid.Row="0" Text="用户名" Style="{DynamicResource ClassicLabel}"/>
      <TextBox    Grid.Row="1" x:Name="UserNameBox" Margin="0,0,0,9" AutomationProperties.Name="用户名"/>
      <c:PixelText Grid.Row="2" Text="QQ" Style="{DynamicResource ClassicLabel}"/>
      <TextBox    Grid.Row="3" x:Name="OicqBox" Margin="0,0,0,9" AutomationProperties.Name="QQ"/>
      <c:PixelText Grid.Row="4" Text="新密码（6-128）" Style="{DynamicResource ClassicLabel}"/>
      <PasswordBox Grid.Row="5" x:Name="PasswordBox" Margin="0,0,0,9" AutomationProperties.Name="新密码"/>
      <c:PixelText Grid.Row="6" Text="确认新密码" Style="{DynamicResource ClassicLabel}"/>
      <PasswordBox Grid.Row="7" x:Name="ConfirmBox" Margin="0,0,0,9" AutomationProperties.Name="确认新密码"/>
      <c:SkinButton Grid.Row="8" x:Name="SubmitBtn" Content="重置密码" Style="{DynamicResource ClassicButton}" HorizontalAlignment="Right"
                    IsDefault="True" Margin="0,4,0,0" Click="SubmitBtn_Click"/>
    </Grid>
  </c:ClassicDialogFrame>
</Window>
