<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:DFLegacy.Launcher.Controls">
  <SolidColorBrush x:Key="ClassicGold" Color="#FFD883"/>
  <SolidColorBrush x:Key="ClassicInk" Color="#F4E9CA"/>
  <SolidColorBrush x:Key="ClassicSecondary" Color="#D7CDAE"/>
  <BitmapImage x:Key="ClassicSmall0" UriSource="/DFLegacy.Launcher;component/Assets/Skin/classic-small0.png"/>
  <BitmapImage x:Key="ClassicSmall1" UriSource="/DFLegacy.Launcher;component/Assets/Skin/classic-small1.png"/>
  <BitmapImage x:Key="ClassicSmall2" UriSource="/DFLegacy.Launcher;component/Assets/Skin/classic-small2.png"/>
  <BitmapImage x:Key="ClassicPanel" UriSource="/DFLegacy.Launcher;component/Assets/Skin/classic-settings-panel.png"/>
  <Style TargetType="c:PixelText">
    <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource ClassicInk}"/>
    <Setter Property="OutlineThickness" Value="1"/>
  </Style>
  <Style x:Key="ClassicLabel" TargetType="c:PixelText" BasedOn="{StaticResource {x:Type c:PixelText}}">
    <Setter Property="Foreground" Value="{StaticResource ClassicGold}"/><Setter Property="Margin" Value="0,0,0,7"/>
  </Style>
  <Style x:Key="ClassicNotice" TargetType="c:PixelText" BasedOn="{StaticResource {x:Type c:PixelText}}">
    <Setter Property="Foreground" Value="{StaticResource ClassicGold}"/><Setter Property="Margin" Value="0,0,0,10"/>
    <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="ClassicScrollButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border x:Name="Surface" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#51432A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="12"/><Setter Property="Background" Value="#202219"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Border Background="{TemplateBinding Background}" BorderBrush="#625638" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="12"/><RowDefinition/><RowDefinition Height="12"/></Grid.RowDefinitions>
        <RepeatButton Style="{StaticResource ClassicScrollButton}" Command="{x:Static ScrollBar.LineUpCommand}"><Path Data="M 0,4 L 4,0 L 8,4" Stroke="{StaticResource ClassicGold}" StrokeThickness="1"/></RepeatButton>
        <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True" Orientation="Vertical">
          <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ClassicScrollButton}" Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb MinHeight="18" Style="{x:Null}"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#897447" BorderBrush="#C5A66D" BorderThickness="1" Margin="2,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ClassicScrollButton}" Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton>
        </Track>
        <RepeatButton Grid.Row="2" Style="{StaticResource ClassicScrollButton}" Command="{x:Static ScrollBar.LineDownCommand}"><Path Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource ClassicGold}" StrokeThickness="1"/></RepeatButton>
      </Grid></Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ClassicButton" TargetType="c:SkinButton">
    <Setter Property="NormalSource" Value="{StaticResource ClassicSmall0}"/><Setter Property="HoverSource" Value="{StaticResource ClassicSmall1}"/><Setter Property="PressedSource" Value="{StaticResource ClassicSmall2}"/>
    <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource ClassicGold}"/>
    <Setter Property="Padding" Value="8,0"/><Setter Property="MinWidth" Value="70"/><Setter Property="Height" Value="30"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="c:SkinButton">
      <Grid Background="Transparent">
        <c:SkinFrame x:Name="Frame" Source="{TemplateBinding NormalSource}" Insets="5,4,5,4" Fill="#27261D"/>
        <c:PixelText Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" TextWrapping="NoWrap" TextAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Source" Value="{Binding HoverSource, RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Source" Value="{Binding PressedSource, RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="Source" Value="{Binding HoverSource, RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ClassicImageButton" TargetType="c:SkinButton" BasedOn="{StaticResource ClassicButton}">
    <Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="c:SkinButton">
      <Grid Background="Transparent">
        <Image x:Name="Artwork" Source="{TemplateBinding NormalSource}" Stretch="Fill"/>
        <c:PixelText Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" Padding="{TemplateBinding Padding}" TextAlignment="Center" TextWrapping="NoWrap" IsHitTestVisible="False"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Artwork" Property="Source" Value="{Binding HoverSource, RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Artwork" Property="Source" Value="{Binding PressedSource, RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Artwork" Property="Source" Value="{Binding HoverSource, RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="宋体"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource ClassicInk}"/><Setter Property="CaretBrush" Value="{StaticResource ClassicInk}"/>
    <Setter Property="Background" Value="#141611"/><Setter Property="BorderBrush" Value="#97815A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,0"/>
    <Setter Property="MinHeight" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#735E38"/>
    <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
        <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Border>
      <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#FFE5AD"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="FontFamily" Value="宋体"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource ClassicInk}"/><Setter Property="CaretBrush" Value="{StaticResource ClassicInk}"/>
    <Setter Property="Background" Value="#141611"/><Setter Property="BorderBrush" Value="#97815A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,0"/><Setter Property="MinHeight" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ClassicComboItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource ClassicInk}"/><Setter Property="Padding" Value="8,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Frame" Background="Transparent" Padding="{TemplateBinding Padding}"><c:PixelText Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" TextWrapping="NoWrap"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="#51432A"/><Setter Property="Foreground" Value="{StaticResource ClassicGold}"/></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="#423A28"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="宋体"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource ClassicInk}"/><Setter Property="MinHeight" Value="34"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource ClassicComboItem}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <ToggleButton Style="{x:Null}" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Frame" Background="#141611" BorderBrush="#97815A" BorderThickness="1"><Grid Margin="9,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><c:PixelText Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Foreground="{StaticResource ClassicInk}" TextWrapping="NoWrap"/><Path Grid.Column="1" Data="M 1,1 L 6,6 L 11,1" Stroke="{StaticResource ClassicGold}" StrokeThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#FFE5AD"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <Border x:Name="Focus" BorderBrush="#FFE5AD" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
          <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,3,0,0"><c:SkinFrame Source="{StaticResource ClassicPanel}" Fill="#24271E"/><ScrollViewer Style="{x:Null}" Margin="8" MaxHeight="220" VerticalScrollBarVisibility="Auto" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Grid>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{StaticResource ClassicGold}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
      <ToggleButton Style="{x:Null}" Height="24" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="13"/><ColumnDefinition/></Grid.ColumnDefinitions><Path x:Name="Arrow" Data="M 0,0 L 4,4 L 0,8 Z" Fill="{StaticResource ClassicGold}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/><c:PixelText Grid.Column="1" Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" Foreground="{StaticResource ClassicGold}" TextWrapping="NoWrap"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter x:Name="Details" Visibility="Collapsed" Margin="0,8,0,4"/>
    </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource ClassicInk}"/><Setter Property="Margin" Value="0,0,0,8"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="17"/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="Frame" Width="15" Height="15" BorderBrush="Transparent" BorderThickness="1" VerticalAlignment="Center"><Image x:Name="Check" Source="/DFLegacy.Launcher;component/Assets/Skin/checkbox_00.png"/></Border><c:PixelText Grid.Column="1" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Margin="8,0,0,0" Foreground="{TemplateBinding Foreground}"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Source" Value="/DFLegacy.Launcher;component/Assets/Skin/checkbox_01.png"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#FFE5AD"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ClassicTab" TargetType="TabItem">
    <Setter Property="Foreground" Value="#E0C180"/><Setter Property="Margin" Value="0,0,12,0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Grid Width="110" Height="29" Background="Transparent"><c:SkinFrame x:Name="Frame" Source="{StaticResource ClassicSmall0}" Insets="5,4,5,4" Fill="#27261D"/><c:PixelText Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" TextAlignment="Center" Foreground="{TemplateBinding Foreground}" TextWrapping="NoWrap"/></Grid><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Source" Value="{StaticResource ClassicSmall1}"/><Setter Property="Foreground" Value="{StaticResource ClassicGold}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="Source" Value="{StaticResource ClassicSmall1}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ClassicTabs" TargetType="TabControl">
    <Setter Property="ItemContainerStyle" Value="{StaticResource ClassicTab}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="30"/><RowDefinition/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" IsItemsHost="True"/><Border Grid.Row="1" BorderBrush="#655333" BorderThickness="0,1,0,0" Margin="0,7,0,0"/><ContentPresenter Grid.Row="2" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
