<Window x:Class="DFLegacy.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DFLegacy.Launcher.Controls"
        Title="地下城与勇士" Width="567" Height="512" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="pack://application:,,,/DFLegacy.Launcher;component/Assets/Skin/QQGame.ico" MouseLeftButtonDown="Window_MouseLeftButtonDown" KeyDown="Window_KeyDown">
  <Window.Resources><ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Views/ClassicStyles.xaml"/></ResourceDictionary.MergedDictionaries>
    <!-- WPF forwards Padding to the content host and reserves 2px in TextBoxView
         for the bidi caret. Apply padding once: 3px + 2px = the artwork's 5px inset. -->
    <Style x:Key="LoginText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="3,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LoginPassword" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
      <Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="3,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LoginAgree" TargetType="CheckBox"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Width="15" Height="15"><Image x:Name="Check" Source="Assets/Skin/checkbox_00.png"/><Border x:Name="Focus" BorderBrush="#FFE5AD" BorderThickness="1" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Source" Value="Assets/Skin/checkbox_01.png"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="NewsButton" TargetType="c:SkinButton" BasedOn="{StaticResource ClassicButton}"><Setter Property="Height" Value="19"/><Setter Property="MinWidth" Value="0"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{StaticResource ClassicInk}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="c:SkinButton"><Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"><c:PixelText Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="12" Foreground="{TemplateBinding Foreground}" TextWrapping="NoWrap"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource ClassicGold}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource ClassicGold}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="NewsTag" TargetType="Border"><Setter Property="Background" Value="#59370E"/><Setter Property="BorderBrush" Value="#361E07"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Width" Value="33"/><Setter Property="Height" Value="19"/></Style>
    <Style x:Key="ClassicMenuItem" TargetType="MenuItem"><Setter Property="Foreground" Value="{StaticResource ClassicGold}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Frame" Background="Transparent" Padding="10,5"><c:PixelText Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" TextWrapping="NoWrap"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="#51432A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </ResourceDictionary></Window.Resources>
  <Grid Width="567" Height="512">
    <Canvas x:Name="LoginPage" Width="567" Height="512">
      <Image Width="567" Height="512" Source="Assets/Skin/classic-login-background.png"/>
      <c:SkinButton Canvas.Left="526" Canvas.Top="57" Width="25" Height="23" Style="{StaticResource ClassicImageButton}" NormalSource="Assets/Skin/buton_close00.png" HoverSource="Assets/Skin/buton_close01.png" PressedSource="Assets/Skin/buton_close02.png" AutomationProperties.Name="关闭登录器" Click="Close_Click"/>
      <c:SkinButton x:Name="RegistrationButton" Canvas.Left="19" Canvas.Top="85" Width="70" Height="21" FontSize="12" Style="{StaticResource ClassicButton}" Content="注册账号" AutomationProperties.Name="注册账号" Click="RegisterBtn_Click"/>
      <c:SkinButton Canvas.Left="90" Canvas.Top="85" Width="70" Height="21" FontSize="12" Style="{StaticResource ClassicButton}" Content="修改密码" Click="ModifyBtn_Click"/>
      <c:SkinButton Canvas.Left="161" Canvas.Top="85" Width="70" Height="21" FontSize="12" Style="{StaticResource ClassicButton}" Content="找回密码" Click="ResetBtn_Click"/>
      <c:SkinButton Canvas.Left="336" Canvas.Top="85" Width="70" Height="21" FontSize="12" Style="{StaticResource ClassicButton}" Content="账号管理" Click="AccountEditBtn_Click"/>
      <c:SkinButton Canvas.Left="406" Canvas.Top="85" Width="70" Height="21" FontSize="12" Style="{StaticResource ClassicButton}" Content="游戏设置" Click="ConfigBtn_Click"/>
      <c:SkinButton x:Name="MoreServicesButton" Canvas.Left="476" Canvas.Top="85" Width="70" Height="21" FontSize="12" Style="{StaticResource ClassicButton}" Content="更多服务" Click="MoreServices_Click">
        <c:SkinButton.ContextMenu><ContextMenu Background="#24271E" BorderBrush="#987D4F" BorderThickness="1" Padding="6" ItemContainerStyle="{StaticResource ClassicMenuItem}">
          <MenuItem x:Name="CheckUpdatesMenu" Header="检查更新" Click="CheckUpdates_Click"/>
          <MenuItem Header="官方网站" Tag="http://dnf.qq.com/" Click="ServiceUrl_Click"/><MenuItem Header="客服服务" Tag="http://gcs.qq.com/gcs/index.shtml" Click="ServiceUrl_Click"/>
          <MenuItem Header="商城充值" Tag="http://dnf.qq.com/web200805/pay.htm" Click="ServiceUrl_Click"/><MenuItem Header="游戏论坛" Tag="http://gamebbs.qq.com/" Click="ServiceUrl_Click"/>
        </ContextMenu></c:SkinButton.ContextMenu>
      </c:SkinButton>
      <Image x:Name="BannerImage" Canvas.Left="21" Canvas.Top="140" Width="315" Height="202" Source="Assets/Skin/classic-banner0.png"/>
      <Border Canvas.Left="21" Canvas.Top="311" Width="315" Height="31" Background="#B4120F07"/>
      <c:PixelText x:Name="BannerCaption" Canvas.Left="31" Canvas.Top="312" Width="285" Height="19" Text="勇士，欢迎重返阿拉德" Foreground="{StaticResource ClassicGold}" TextWrapping="NoWrap"/>
      <c:SkinButton x:Name="Slide0" Canvas.Left="214" Canvas.Top="326" Width="21" MinWidth="0" Height="16" FontSize="13" Padding="0" Style="{StaticResource ClassicButton}" Content="1" Tag="0" AutomationProperties.Name="宣传图 1" Click="Slide_Click"/>
      <c:SkinButton x:Name="Slide1" Canvas.Left="237" Canvas.Top="326" Width="21" MinWidth="0" Height="16" FontSize="13" Padding="0" Style="{StaticResource ClassicButton}" Content="2" Tag="1" AutomationProperties.Name="宣传图 2" Click="Slide_Click"/>
      <c:SkinButton x:Name="Slide2" Canvas.Left="260" Canvas.Top="326" Width="21" MinWidth="0" Height="16" FontSize="13" Padding="0" Style="{StaticResource ClassicButton}" Content="3" Tag="2" AutomationProperties.Name="宣传图 3" Click="Slide_Click"/>
      <c:SkinButton x:Name="Slide3" Canvas.Left="283" Canvas.Top="326" Width="21" MinWidth="0" Height="16" FontSize="13" Padding="0" Style="{StaticResource ClassicButton}" Content="4" Tag="3" AutomationProperties.Name="宣传图 4" Click="Slide_Click"/>
      <c:SkinButton x:Name="Slide4" Canvas.Left="306" Canvas.Top="326" Width="21" MinWidth="0" Height="16" FontSize="13" Padding="0" Style="{StaticResource ClassicButton}" Content="5" Tag="4" AutomationProperties.Name="宣传图 5" Click="Slide_Click"/>
      <c:PixelText Canvas.Left="355" Canvas.Top="137" Width="185" Height="27" Text="公告新闻" FontSize="20" Foreground="{StaticResource ClassicGold}" TextWrapping="NoWrap"/>
      <c:PixelText Canvas.Left="357" Canvas.Top="164" Width="180" Height="14" Text="ARAD NEWS" FontSize="10" Foreground="#E0B75E" TextWrapping="NoWrap"/>
      <Border Canvas.Left="350" Canvas.Top="183" Style="{StaticResource NewsTag}"><c:PixelText Text="公告" FontSize="13" TextAlignment="Center" Foreground="{StaticResource ClassicGold}" TextWrapping="NoWrap"/></Border>
      <c:SkinButton Canvas.Left="389" Canvas.Top="182" Width="154" Style="{StaticResource NewsButton}" Content="欢迎来到阿拉德大陆" Tag="welcome" Click="News_Click"/>
      <Border Canvas.Left="350" Canvas.Top="208" Style="{StaticResource NewsTag}"><c:PixelText Text="指南" FontSize="13" TextAlignment="Center" Foreground="{StaticResource ClassicGold}" TextWrapping="NoWrap"/></Border>
      <c:SkinButton Canvas.Left="389" Canvas.Top="207" Width="154" Style="{StaticResource NewsButton}" Content="客户端安装与启动" Tag="install" Click="News_Click"/>
      <Border Canvas.Left="350" Canvas.Top="233" Style="{StaticResource NewsTag}"><c:PixelText Text="账号" FontSize="13" TextAlignment="Center" Foreground="{StaticResource ClassicGold}" TextWrapping="NoWrap"/></Border>
      <c:SkinButton Canvas.Left="389" Canvas.Top="232" Width="154" Style="{StaticResource NewsButton}" Content="注册与密码找回" Tag="account" Click="News_Click"/>
      <Border Canvas.Left="350" Canvas.Top="258" Style="{StaticResource NewsTag}"><c:PixelText Text="设置" FontSize="13" TextAlignment="Center" Foreground="{StaticResource ClassicGold}" TextWrapping="NoWrap"/></Border>
      <c:SkinButton Canvas.Left="389" Canvas.Top="257" Width="154" Style="{StaticResource NewsButton}" Content="分辨率与画质说明" Tag="display" Click="News_Click"/>
      <Border Canvas.Left="350" Canvas.Top="283" Style="{StaticResource NewsTag}"><c:PixelText Text="帮助" FontSize="13" TextAlignment="Center" Foreground="{StaticResource ClassicGold}" TextWrapping="NoWrap"/></Border>
      <c:SkinButton Canvas.Left="389" Canvas.Top="282" Width="154" Style="{StaticResource NewsButton}" Content="连接与常见问题" Tag="connection" Click="News_Click"/>
      <Border Canvas.Left="350" Canvas.Top="308" Style="{StaticResource NewsTag}"><c:PixelText Text="公告" FontSize="13" TextAlignment="Center" Foreground="{StaticResource ClassicGold}" TextWrapping="NoWrap"/></Border>
      <c:SkinButton Canvas.Left="389" Canvas.Top="307" Width="154" Style="{StaticResource NewsButton}" Content="冒险旅程，从这里开始" Tag="welcome" Click="News_Click"/>
      <c:SkinButton Canvas.Left="25" Canvas.Top="358" Width="116" Height="77" Style="{StaticResource ClassicImageButton}" NormalSource="Assets/Skin/choose_00.png" HoverSource="Assets/Skin/choose_01.png" PressedSource="Assets/Skin/choose_02.png" AutomationProperties.Name="选择服务器" Click="SelectServer_Click"/>
      <c:PixelText Canvas.Left="164" Canvas.Top="369" Width="65" Height="17" Text="游戏账号" Foreground="{StaticResource ClassicGold}" TextWrapping="NoWrap"/>
      <c:PixelText Canvas.Left="164" Canvas.Top="392" Width="65" Height="17" Text="账号密码" Foreground="{StaticResource ClassicGold}" TextWrapping="NoWrap"/>
      <TextBox x:Name="AccountText" Canvas.Left="234" Canvas.Top="369" Width="164" Height="17" MaxLength="32" Style="{StaticResource LoginText}" AutomationProperties.Name="游戏账号"/>
      <c:PixelText x:Name="AccountHint" Canvas.Left="239" Canvas.Top="369" Width="154" Height="17" Text="请输入账号" Foreground="{StaticResource ClassicSecondary}" OutlineThickness="0" TextWrapping="NoWrap" IsHitTestVisible="False"/>
      <PasswordBox x:Name="PasswordText" Canvas.Left="234" Canvas.Top="392" Width="164" Height="17" MaxLength="128" Style="{StaticResource LoginPassword}" AutomationProperties.Name="账号密码"/>
      <c:PixelText x:Name="PasswordHint" Canvas.Left="239" Canvas.Top="392" Width="154" Height="17" Text="请输入密码" Foreground="{StaticResource ClassicSecondary}" OutlineThickness="0" TextWrapping="NoWrap" IsHitTestVisible="False"/>
      <CheckBox x:Name="AgreeBox" Canvas.Left="232" Canvas.Top="414" IsChecked="True" Style="{StaticResource LoginAgree}" AutomationProperties.Name="同意服务条款"/>
      <Border Canvas.Left="247" Canvas.Top="411" Width="138" Height="18" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="TermsLink_Click"/>
      <c:PixelText Canvas.Left="124" Canvas.Top="444" Width="345" Height="15" Text="抵制不良游戏，拒绝盗版游戏。注意自我保护。" FontSize="11" Foreground="#B2925D" OutlineThickness="0" TextWrapping="NoWrap"/>
      <c:SkinButton Canvas.Left="428" Canvas.Top="358" Width="116" Height="77" Style="{StaticResource ClassicImageButton}" NormalSource="Assets/Skin/enter_00.png" HoverSource="Assets/Skin/enter_01.png" PressedSource="Assets/Skin/enter_02.png" AutomationProperties.Name="进入游戏" Click="EnterGame_Click"/>
      <!-- The real account-management dialog selects profiles; no duplicate account toolbar is shown here. -->
      <ListBox x:Name="AccountList" Visibility="Collapsed" IsTabStop="False" SelectionChanged="AccountList_SelectionChanged"/>
    </Canvas>
    <Canvas x:Name="ServerPage" Width="567" Height="512" Visibility="Collapsed">
      <Image Width="567" Height="512" Source="Assets/Skin/classic-server.png"/>
      <c:SkinButton Canvas.Left="526" Canvas.Top="57" Width="25" Height="23" Style="{StaticResource ClassicImageButton}" NormalSource="Assets/Skin/buton_close00.png" HoverSource="Assets/Skin/buton_close01.png" PressedSource="Assets/Skin/buton_close02.png" AutomationProperties.Name="关闭登录器" Click="Close_Click"/>
      <ScrollViewer x:Name="TelecomScroll" Canvas.Left="88" Canvas.Top="151" Width="427" Height="123" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="TelecomChoices"/>
      </ScrollViewer>
      <ScrollViewer x:Name="NetcomScroll" Canvas.Left="88" Canvas.Top="303" Width="427" Height="61" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="NetcomChoices"/>
      </ScrollViewer>
      <ScrollViewer Canvas.Left="88" Canvas.Top="376" Width="420" Height="26" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <c:PixelText x:Name="ServerEndpointText" FontSize="11"/>
          <StackPanel Orientation="Horizontal" Visibility="Collapsed">
            <Ellipse x:Name="ServerDot" Width="7" Height="7" Fill="Gray" Margin="0,0,5,0"/>
            <c:PixelText x:Name="ServerText" Text="服务端：未选择" FontSize="11" Margin="0,0,12,0"/>
            <Ellipse x:Name="ApiDot" Width="7" Height="7" Fill="Gray" Margin="0,0,5,0"/>
            <c:PixelText x:Name="ApiText" Text="账号服务：未选择" FontSize="11"/>
          </StackPanel>
          <c:PixelText x:Name="ServerAddr" Visibility="Collapsed"/>
          <c:PixelText x:Name="ServerSelectionError" Foreground="#FFE0A0" FontSize="11"/>
        </StackPanel>
      </ScrollViewer>
      <c:PixelText x:Name="SelectedServerText" Canvas.Left="222" Canvas.Top="424" Width="145" Height="22" FontSize="11" Text="请选择服务器" TextWrapping="NoWrap"/>
      <c:SkinButton Canvas.Left="25" Canvas.Top="429" Width="70" Height="21" FontSize="12" Style="{StaticResource ClassicButton}" Content="返回登录" Click="BackToLogin_Click"/>
      <c:SkinButton x:Name="ConfirmServerButton" IsEnabled="False" Canvas.Left="428" Canvas.Top="416" Width="110" Height="40" Style="{StaticResource ClassicImageButton}" NormalSource="Assets/Skin/classic-confirm0.png" HoverSource="Assets/Skin/classic-confirm1.png" PressedSource="Assets/Skin/classic-confirm2.png" AutomationProperties.Name="确认选择" Click="ConfirmServer_Click"/>
    </Canvas>
    <Border x:Name="ModalShade" Background="#96000000" Visibility="Collapsed"><Border.OpacityMask><ImageBrush ImageSource="Assets/Skin/classic-login-background.png" Stretch="Fill"/></Border.OpacityMask></Border>
  </Grid>
</Window>
