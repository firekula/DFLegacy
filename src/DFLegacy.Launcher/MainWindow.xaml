<Window x:Class="DFLegacy.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="DFLegacy 启动器" Height="520" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
      <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#ccc" VerticalAlignment="Center"/>
      <TextBlock x:Name="StatusText" Text="检测中…" Margin="8,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,0,0,8">
      <TextBlock Text="账号"/>
      <ComboBox x:Name="AccountBox" SelectionChanged="AccountBox_SelectionChanged" Margin="0,4,0,0"
                DisplayMemberPath="Display"/>
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="0,0,0,8">
      <TextBlock Text="密码"/>
      <PasswordBox x:Name="PasswordBox" Margin="0,4,0,0"/>
    </StackPanel>

    <UniformGrid Grid.Row="3" Columns="2" Rows="3" Margin="0,8,0,8">
      <Button x:Name="RegisterBtn"   Content="注册账号" IsEnabled="True" Margin="4" Click="RegisterBtn_Click"/>
      <Button x:Name="ModifyBtn"     Content="修改密码" IsEnabled="True" Margin="4" Click="ModifyBtn_Click"/>
      <Button x:Name="ResetBtn"      Content="找回密码" IsEnabled="True" Margin="4" Click="ResetBtn_Click"/>
      <Button x:Name="AccountEditBtn" Content="账号管理" IsEnabled="True" Margin="4" Click="AccountEditBtn_Click"/>
      <Button x:Name="ConfigBtn"     Content="设置"     IsEnabled="False" Margin="4" Click="ConfigBtn_Click"/>
      <Button Content="刷新状态" Margin="4" Click="RefreshBtn_Click"/>
    </UniformGrid>

    <Button Grid.Row="4" x:Name="StartBtn" Content="启动游戏" Height="40" Click="StartBtn_Click"/>
  </Grid>
</Window>
