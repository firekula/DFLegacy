<Window x:Class="DFLegacy.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="地下城与勇士"
        Width="567" Height="512"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/Assets/Skin/QQGame.ico"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">
  <!--
    按原版 2008 登录器 1:1 还原：窗口 567x512 + backgd_di1.png 背景。
    所有元素坐标取自客户端 config\layout\QQLogin.xml（Left/Top/Width/Height 一一对应）；
    按钮文字已烙在原始图片里，因此全部用图片按钮（三态在 SkinImage.cs 中切换）。
    背景图的品红透明区已用 tools/key-magenta.ps1 抠成 alpha=0，配合 AllowsTransparency
    由系统按 alpha 合成，透明处的点击也会穿透到桌面（沿用原版 RegionSet 的效果）。
  -->
  <Window.Resources>
    <!-- 原版输入框：无边框、透明底、白字白光标（QQLogin.xml: HasBorder=false, TextColor=0xffffff） -->
    <Style x:Key="SkinTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="SelectionBrush" Value="#803A6EA5"/>
      <Setter Property="FontFamily" Value="宋体"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"
                          BorderThickness="0" Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SkinPasswordBox" TargetType="PasswordBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="FontFamily" Value="宋体"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"
                          BorderThickness="0" Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 原版勾选框：checkbox_00.png / checkbox_01.png -->
    <Style x:Key="SkinCheckBox" TargetType="CheckBox">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Image x:Name="Box" Width="15" Height="15" Stretch="Fill"
                   Source="pack://application:,,,/Assets/Skin/checkbox_00.png"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Source"
                        Value="pack://application:,,,/Assets/Skin/checkbox_01.png"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 中部信息面板里的账号列表：透明底、浅色文字，尽量不打扰原版画面 -->
    <Style x:Key="SkinListBox" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#EEEEEE"/>
      <Setter Property="DisplayMemberPath" Value="Display"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                          Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="#557FB8E8"/>
                      <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Canvas Width="567" Height="512">
    <!-- 背景（原版 Dialog_Main 背景图，567x512） -->
    <Image Canvas.Left="0" Canvas.Top="0" Width="567" Height="512" Stretch="Fill"
           Source="pack://application:,,,/Assets/Skin/backgd_di1.png"/>

    <!-- 标题栏区域（原版 CaptionHeight=100，可拖动）内的关闭按钮：526,57 25x23 -->
    <Image x:Name="CloseImage" Canvas.Left="526" Canvas.Top="57" Width="25" Height="23"/>

    <!-- 顶部小按钮行 Y=85，均为 70x21（顺序与 QQLogin.xml 一致） -->
    <Image x:Name="RegisterImage" Canvas.Left="19" Canvas.Top="85" Width="70" Height="21"/>
    <Image x:Name="SiteImage" Canvas.Left="90" Canvas.Top="85" Width="70" Height="21"/>
    <Image x:Name="ServiceImage" Canvas.Left="161" Canvas.Top="85" Width="70" Height="21"/>
    <Image x:Name="PayImage" Canvas.Left="336" Canvas.Top="85" Width="70" Height="21"/>
    <Image x:Name="ForumImage" Canvas.Left="406" Canvas.Top="85" Width="70" Height="21"/>
    <Image x:Name="AccountsImage" Canvas.Left="476" Canvas.Top="85" Width="70" Height="21"/>

    <!-- 中部：原版此处是公告 WebBrowser（17,113 533x232，默认隐藏）。私服没有公告页，
         这里放我们自己的信息面板：服务端/账号服务状态、本地账号列表、改密与找回入口。
         半透明深色底，尽量贴合原版画面又不喧宾夺主。 -->
    <Border Canvas.Left="17" Canvas.Top="113" Width="533" Height="232"
            Background="#7F000000" CornerRadius="4" Padding="16,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
          <Ellipse x:Name="ServerDot" Width="10" Height="10" Fill="#888888" VerticalAlignment="Center"/>
          <TextBlock x:Name="ServerText" Text="检测中…" Margin="8,0,0,0"
                     Foreground="White" FontSize="13" FontFamily="微软雅黑" VerticalAlignment="Center"/>
          <TextBlock x:Name="ServerAddr" Margin="10,0,0,0" Foreground="#AAAAAA"
                     FontSize="12" FontFamily="微软雅黑" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
          <Ellipse x:Name="ApiDot" Width="10" Height="10" Fill="#888888" VerticalAlignment="Center"/>
          <TextBlock x:Name="ApiText" Text="账号服务：检测中…" Margin="8,0,0,0"
                     Foreground="#CCCCCC" FontSize="12" FontFamily="微软雅黑" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="本地账号（点选切换，可在下面修改密码/找回密码）"
                   Foreground="#AAAAAA" FontSize="12" FontFamily="微软雅黑" Margin="0,14,0,4"/>
        <ListBox Grid.Row="3" x:Name="AccountList" Style="{StaticResource SkinListBox}"
                 SelectionChanged="AccountList_SelectionChanged"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
          <Button x:Name="RegistrationButton" Content="注册账号" Click="RegisterBtn_Click"
                  AutomationProperties.Name="注册账号" ToolTip="注册新账号（Tab 选择，空格键打开）"
                  Background="Transparent" Foreground="#A8D7FF" BorderBrush="Transparent"
                  BorderThickness="1" Padding="4,0" FontSize="12" FontFamily="微软雅黑"
                  Cursor="Hand" Focusable="True" IsTabStop="True">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="RegistrationBorder" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2" Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="RegistrationBorder" Property="Background" Value="#33FFFFFF"/>
                  </Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="RegistrationBorder" Property="BorderBrush" Value="#A8D7FF"/>
                    <Setter TargetName="RegistrationBorder" Property="Background" Value="#33FFFFFF"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <TextBlock Text="|" Foreground="#666666" Margin="10,0" FontSize="12"/>
          <TextBlock x:Name="ModifyLink" Text="修改密码" Foreground="#7FB8E8" FontSize="12"
                     FontFamily="微软雅黑" Cursor="Hand" MouseLeftButtonUp="ModifyLink_Click"/>
          <TextBlock Text="|" Foreground="#666666" Margin="10,0" FontSize="12"/>
          <TextBlock x:Name="ResetLink" Text="找回密码" Foreground="#7FB8E8" FontSize="12"
                     FontFamily="微软雅黑" Cursor="Hand" MouseLeftButtonUp="ResetLink_Click"/>
          <TextBlock Text="|" Foreground="#666666" Margin="10,0" FontSize="12"/>
          <TextBlock x:Name="ManageLink" Text="账号管理" Foreground="#7FB8E8" FontSize="12"
                     FontFamily="微软雅黑" Cursor="Hand" MouseLeftButtonUp="ManageLink_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 左侧大按钮：原版选择服务器（25,358 116x77, choose_*）→ 本启动器的设置（服务器/中继/主题） -->
    <Image x:Name="SettingsImage" Canvas.Left="25" Canvas.Top="358" Width="116" Height="77"/>

    <!-- 账号（原版 238,370 150x15）与密码（239,394 150x14），白字无边框 -->
    <TextBox x:Name="AccountText" Canvas.Left="238" Canvas.Top="368" Width="150" Height="18"
             MaxLength="32" Style="{StaticResource SkinTextBox}"/>
    <TextBlock x:Name="AccountHint" Canvas.Left="240" Canvas.Top="371" Text="请输入账号"
               Foreground="#C8C8C8" FontSize="12" FontFamily="宋体" IsHitTestVisible="False"/>
    <PasswordBox x:Name="PasswordText" Canvas.Left="239" Canvas.Top="392" Width="150" Height="18"
                 MaxLength="128" Style="{StaticResource SkinPasswordBox}"/>

    <!-- 同意服务条款（原版勾选框 232,414 15x15 + 服务条款热区 247,411 138x18；文字在原版背景图里） -->
    <CheckBox x:Name="AgreeBox" Canvas.Left="232" Canvas.Top="414" IsChecked="True"
              Style="{StaticResource SkinCheckBox}"/>
    <Border Canvas.Left="247" Canvas.Top="411" Width="138" Height="18" Background="Transparent"
            Cursor="Hand" MouseLeftButtonUp="TermsLink_Click"/>

    <!-- 底部提示（原版 Static_Gdxx：121,444 345x15，颜色 RGB(154,123,83)） -->
    <TextBlock Canvas.Left="121" Canvas.Top="444" Width="345" Height="15"
               Text="抵制不良游戏，拒绝盗版游戏。注意自我保护，谨防受骗上当。"
               Foreground="#9A7B53" FontSize="11" FontFamily="宋体"/>

    <!-- 右侧大按钮：进入游戏（428,358 116x77, enter_*）→ 启动客户端 -->
    <Image x:Name="EnterImage" Canvas.Left="428" Canvas.Top="358" Width="116" Height="77"/>
  </Canvas>
</Window>
