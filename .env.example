# Public GHCR image, e.g. ghcr.io/firekula/dflegacy:v0.1.2. A digest can pin it exactly.
DFLEGACY_IMAGE=
# Sandbox only: all account kinds, character-name Cera and diamond grants, no payment provider.
ENABLE_TEST_CERA_TOP_UP=false
# Optional absolute existing file for compose.pvf.yaml; normal setup uploads through Manager.
PVF_PATH=
MANAGER_BIND=127.0.0.1
MANAGER_PORT=18080
# Leave blank to use GitHub client updates. Set an HTTP(S) origin only for self-hosting.
# HTTPS: forward the public listener to the host binding below.
# Direct HTTP on 18083: set UPDATE_BIND=0.0.0.0 and an http:// URL.
UPDATE_PUBLIC_URL=
UPDATE_BIND=127.0.0.1
UPDATE_PORT=18083
# Comma-separated management domains; loopback hosts are accepted by default.
MANAGER_ALLOWED_HOSTS=
# Comma-separated proxy IPs allowed to supply forwarded HTTPS/host headers.
MANAGER_TRUSTED_PROXIES=
# Player account API. Use an HTTPS proxy for untrusted networks.
GAME_API_BIND=0.0.0.0
GAME_API_PORT=8081
GM_PANEL_BIND=0.0.0.0
GM_PANEL_PORT=18081
PLAYER_PANEL_BIND=0.0.0.0
PLAYER_PANEL_PORT=18082
GAME_BIND=0.0.0.0
